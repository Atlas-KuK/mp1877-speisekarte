# Anthropic API Key für Claude-basierte Reviews
# Hol dir einen Key von https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True

# Netzwerk-Zugriff
# 0.0.0.0 = erreichbar vom Handy/anderen Geräten im Netzwerk
# localhost = nur dieser Computer
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
